  "description": "מערכת לניהול דיווחי נכסים חודשיים וחישוב עמלות סוכני השכרה",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "bash scripts/setup-db.sh",
    "db:reset": "bash scripts/setup-db.sh --reset",
    "seed": "node scripts/seed.mjs",
    "seed:fresh": "node scripts/seed.mjs --fresh",
    "e2e": "playwright test",
    "seed:production": "node scripts/seed.mjs --no-demo --random-passwords",
    "verify:db": "node scripts/verify-rls.mjs",
    "qa:shots": "node scripts/qa-shots.mjs",
    "deploy:supabase": "bash scripts/deploy-supabase.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "motion": "^13.1.1",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
