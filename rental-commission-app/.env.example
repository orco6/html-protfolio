# =============================================================================
# Environment variables
#
# Local development: ./scripts/setup-db.sh generates .env.local for you — you
# should not need to copy this file by hand.
#
# Production: ./scripts/deploy-supabase.sh prints the first three values ready
# to paste into your host. Nothing here is a client-side variable; there is no
# NEXT_PUBLIC_* value in this project, so no secret can reach the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Business-data connection. Logs in as `app_client`, for which row level
# security is FORCED. This is the only role the request path uses for report
# data, and it can never see another agent's rows.
#
# On a serverless host this MUST point at a transaction-mode pooler.
# Supabase: Project Settings → Database → Connection pooling → Transaction (6543).
DATABASE_URL=postgresql://app_client:PASSWORD@127.0.0.1:5432/rental_commissions

# Credentials and session store only. Logs in as `app_auth`, which holds no
# privilege of any kind on report_entries.
AUTH_DATABASE_URL=postgresql://app_auth:PASSWORD@127.0.0.1:5432/rental_commissions

# Keys the HMAC over session tokens. Only the digest is stored, so rotating
# this value logs everybody out — which is exactly what you want after a leak.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------

# The canonical public origin, scheme included. Server Actions are accepted
# only from this origin, which is what stops a third-party page from invoking
# a mutation with the visitor's cookie attached.
# Example: https://commissions.example.com
APP_ORIGIN=

# -----------------------------------------------------------------------------
# OPTIONAL — TLS
# -----------------------------------------------------------------------------

# PEM text of the database provider's CA bundle. With it, the connection is
# verified end to end. Supabase publishes one at
# Project Settings → Database → SSL Configuration → Download certificate.
PGSSLROOTCERT=

# Accept a TLS connection whose chain cannot be verified. Only set this when
# your provider does not publish a CA bundle; without either variable the app
# refuses to start in production rather than connect unverified.
# PGSSL_ALLOW_UNVERIFIED=true

# -----------------------------------------------------------------------------
# OPTIONAL — connection pool tuning
# -----------------------------------------------------------------------------
# Every serverless instance keeps its own pool, so keep this small.
# PG_POOL_MAX=4
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_IDLE_TX_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# LOCAL TOOLING ONLY — never set these on the application host
# -----------------------------------------------------------------------------
# Used by migrations, seeding and scripts/set-password.mjs. The running
# application never reads it.
# OWNER_DATABASE_URL=postgresql://app_owner:PASSWORD@127.0.0.1:5432/rental_commissions

# Overrides the development seed password (default Demo!2345).
# SEED_PASSWORD=
